{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aelios-resident",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Values you change in the Dashboard survive the next deploy.
  "keep_vars": true,
  // Workers AI, plus AI Gateway for vendor models such as anthropic/claude-* and for web search.
  "ai": { "binding": "AI" },
  // The web door (public/index.html). Everything else goes to the Worker first.
  "assets": {
    "directory": "public",
    "run_worker_first": ["/messengers/*", "/tg/*", "/web/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "RESIDENT", "class_name": "Resident" }]
  },
  // SQLite-backed Durable Objects are the kind the Workers Free plan allows.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Resident"] }],
  "observability": { "enabled": true },
  "vars": {
    // A Workers AI id (free plan: 10,000 neurons a day, then errors, never a bill),
    // or a vendor model through AI Gateway such as "anthropic/claude-sonnet-5-5" (AI_GATEWAY_ID picks the
    // gateway; empty = the account's "default"). Changing it switches the running conversation too.
    "MODEL": "@cf/zai-org/glm-4.7-flash",
    "AI_GATEWAY_ID": "",
    // The bot's username from @BotFather, without the @.
    "TG_BOT_USERNAME": "",
    // Comma-separated Telegram chat ids and/or @usernames allowed to talk to the bot.
    "TG_ALLOWED": "",
    "TIME_ZONE": "Asia/Shanghai",
    // Messages sent within this many seconds of each other are answered as one turn.
    "DEBOUNCE_SECONDS": "3",
    // When the conversation passes this many tokens, older turns are folded into a handoff letter.
    "LETTER_AFTER_TOKENS": "24000",
    // How much of the newest conversation stays word for word after a letter.
    "KEEP_RECENT_TOKENS": "6000",
    "SHOW_LETTER": "true",
    // Aelios base URL (e.g. https://companion-memory-proxy.<you>.workers.dev); empty = no long-term memory.
    "AELIOS_URL": "",
    "AELIOS_NAMESPACE": "default",
    // "on" gives the model a web_search tool. Each search is billed to AI Gateway credits.
    "WEB_SEARCH": "off",
    // Comma-separated URL globs the model may read for free, e.g. "https://www.bbc.com/zhongwen/**".
    "FETCH_ALLOWLIST": "",
    // e.g. "every day at 09:00": the resident starts a conversation on its own. Empty = never.
    "CHECKIN_SCHEDULE": ""
  }
  // Secrets (Dashboard → Worker → Settings → Variables and Secrets, type Secret):
  //   TG_BOT_TOKEN         from @BotFather
  //   TG_WEBHOOK_SECRET    any long random string you make up (letters, digits, _ and -)
  //   AELIOS_API_KEY       an Aelios key with memory read/write (CHATBOX_API_KEY lets AELIOS_NAMESPACE apply)
  //   WEB_KEY              the password for the web door; unset = the web door stays shut
  // The persona is not a secret or a var: write it on the web door (the person button, top right).
}
